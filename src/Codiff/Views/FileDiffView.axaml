<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Codiff.ViewModels"
             xmlns:controls="using:Codiff.Controls"
             x:Class="Codiff.Views.FileDiffView"
             x:DataType="vm:FileDiffViewModel"
             Focusable="True">

    <Grid RowDefinitions="Auto,*">

        <!-- File path headers -->
        <Grid Grid.Row="0" ColumnDefinitions="*,4,*" Background="#F8F8F8">
            <Border Grid.Column="0" Padding="8,4" BorderBrush="#DDDDDD" BorderThickness="0,0,0,1"
                    IsVisible="{Binding LeftFileExists}">
                <Grid ColumnDefinitions="*,Auto">
                    <TextBlock Grid.Column="0"
                               Text="{Binding LeftFilePath}"
                               FontFamily="Consolas,Courier New,monospace"
                               FontSize="11"
                               Foreground="#0066CC"
                               TextTrimming="CharacterEllipsis"
                               Cursor="Hand"
                               TextDecorations="Underline"
                               ToolTip.Tip="Click to open in file explorer"
                               PointerPressed="OnLeftPathPointerPressed" />
                    <TextBlock Grid.Column="1"
                               Text="{Binding LeftStatusText}"
                               FontFamily="Consolas,Courier New,monospace"
                               FontSize="11"
                               Foreground="#CC6600"
                               Margin="8,0,0,0"
                               VerticalAlignment="Center" />
                </Grid>
            </Border>
            <Border Grid.Column="1" Background="#DDDDDD" />
            <Border Grid.Column="2" Padding="8,4" BorderBrush="#DDDDDD" BorderThickness="0,0,0,1"
                    IsVisible="{Binding RightFileExists}">
                <Grid ColumnDefinitions="*,Auto">
                    <TextBlock Grid.Column="0"
                               Text="{Binding RightFilePath}"
                               FontFamily="Consolas,Courier New,monospace"
                               FontSize="11"
                               Foreground="#0066CC"
                               TextTrimming="CharacterEllipsis"
                               Cursor="Hand"
                               TextDecorations="Underline"
                               ToolTip.Tip="Click to open in file explorer"
                               PointerPressed="OnRightPathPointerPressed" />
                    <TextBlock Grid.Column="1"
                               Text="{Binding RightStatusText}"
                               FontFamily="Consolas,Courier New,monospace"
                               FontSize="11"
                               Foreground="#CC6600"
                               Margin="8,0,0,0"
                               VerticalAlignment="Center" />
                </Grid>
            </Border>
        </Grid>

        <!-- Side-by-side diff panels -->
        <Grid Grid.Row="1" ColumnDefinitions="*,4,*">

            <!-- Left panel -->
            <Grid Grid.Column="0" ColumnDefinitions="*,12">
                <ScrollViewer x:Name="LeftScrollViewer"
                              Grid.Column="0"
                              HorizontalScrollBarVisibility="Auto"
                              VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding Lines}"
                                  Background="White">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:DiffLineViewModel">
                                <Grid ColumnDefinitions="48,*"
                                      Background="{Binding LeftBackground}"
                                      MinHeight="20">
                                    <!-- Line number -->
                                    <Border Grid.Column="0"
                                            Background="#F0F0F0"
                                            BorderBrush="#DDDDDD"
                                            BorderThickness="0,0,1,0"
                                            Padding="4,1">
                                        <TextBlock Text="{Binding LeftLineNumberText}"
                                                   FontFamily="Consolas,Courier New,monospace"
                                                   FontSize="12"
                                                   Foreground="#888888"
                                                   TextAlignment="Right" />
                                    </Border>
                                    <!-- Content -->
                                    <Border Grid.Column="1" Padding="0,1">
                                        <TextBox Text="{Binding LeftText, Mode=TwoWay}"
                                                 FontFamily="Consolas,Courier New,monospace"
                                                 FontSize="13"
                                                 TextWrapping="NoWrap"
                                                 AcceptsReturn="False"
                                                 BorderThickness="0"
                                                 Padding="4,0"
                                                 MinHeight="18"
                                                 Background="Transparent" />
                                    </Border>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
                <controls:DiffMapControl x:Name="LeftDiffMap"
                                         Grid.Column="1"
                                         Lines="{Binding Lines}" />
            </Grid>

            <!-- Vertical splitter -->
            <GridSplitter Grid.Column="1"
                          Background="#DDDDDD"
                          ResizeDirection="Columns" />

            <!-- Right panel -->
            <Grid Grid.Column="2" ColumnDefinitions="*,12">
                <ScrollViewer x:Name="RightScrollViewer"
                              Grid.Column="0"
                              HorizontalScrollBarVisibility="Auto"
                              VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding Lines}"
                                  Background="White">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:DiffLineViewModel">
                                <Grid ColumnDefinitions="48,*"
                                      Background="{Binding RightBackground}"
                                      MinHeight="20">
                                    <!-- Line number -->
                                    <Border Grid.Column="0"
                                            Background="#F0F0F0"
                                            BorderBrush="#DDDDDD"
                                            BorderThickness="0,0,1,0"
                                            Padding="4,1">
                                        <TextBlock Text="{Binding RightLineNumberText}"
                                                   FontFamily="Consolas,Courier New,monospace"
                                                   FontSize="12"
                                                   Foreground="#888888"
                                                   TextAlignment="Right" />
                                    </Border>
                                    <!-- Content -->
                                    <Border Grid.Column="1" Padding="0,1">
                                        <TextBox Text="{Binding RightText, Mode=TwoWay}"
                                                 FontFamily="Consolas,Courier New,monospace"
                                                 FontSize="13"
                                                 TextWrapping="NoWrap"
                                                 AcceptsReturn="False"
                                                 BorderThickness="0"
                                                 Padding="4,0"
                                                 MinHeight="18"
                                                 Background="Transparent" />
                                    </Border>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
                <controls:DiffMapControl x:Name="RightDiffMap"
                                         Grid.Column="1"
                                         Lines="{Binding Lines}" />
            </Grid>
        </Grid>
    </Grid>
</UserControl>
