<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Codiff.ViewModels"
             x:Class="Codiff.Views.FileDiffView"
             x:DataType="vm:FileDiffViewModel">

    <Grid RowDefinitions="Auto,*">

        <!-- File path headers -->
        <Grid Grid.Row="0" ColumnDefinitions="*,4,*" Background="#F8F8F8"
              IsVisible="{Binding LeftFilePath, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
            <Border Grid.Column="0" Padding="8,4" BorderBrush="#DDDDDD" BorderThickness="0,0,0,1">
                <TextBlock Text="{Binding LeftFilePath}"
                           FontFamily="Consolas,Courier New,monospace"
                           FontSize="11"
                           Foreground="#444444"
                           TextTrimming="LeadingEllipsis"
                           ToolTip.Tip="{Binding LeftFilePath}" />
            </Border>
            <Border Grid.Column="1" Background="#DDDDDD" />
            <Border Grid.Column="2" Padding="8,4" BorderBrush="#DDDDDD" BorderThickness="0,0,0,1">
                <TextBlock Text="{Binding RightFilePath}"
                           FontFamily="Consolas,Courier New,monospace"
                           FontSize="11"
                           Foreground="#444444"
                           TextTrimming="LeadingEllipsis"
                           ToolTip.Tip="{Binding RightFilePath}" />
            </Border>
        </Grid>

        <!-- Side-by-side diff panels -->
        <Grid Grid.Row="1" ColumnDefinitions="*,4,*">

            <!-- Left panel -->
            <ScrollViewer x:Name="LeftScrollViewer"
                          Grid.Column="0"
                          HorizontalScrollBarVisibility="Auto"
                          VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding Lines}"
                              Background="White">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:DiffLineViewModel">
                            <Grid ColumnDefinitions="48,*"
                                  Background="{Binding Background}"
                                  MinHeight="20">
                                <!-- Line number -->
                                <Border Grid.Column="0"
                                        Background="#F0F0F0"
                                        BorderBrush="#DDDDDD"
                                        BorderThickness="0,0,1,0"
                                        Padding="4,1">
                                    <TextBlock Text="{Binding LeftLineNumberText}"
                                               FontFamily="Consolas,Courier New,monospace"
                                               FontSize="12"
                                               Foreground="#888888"
                                               TextAlignment="Right" />
                                </Border>
                                <!-- Content -->
                                <Border Grid.Column="1" Padding="4,1">
                                    <Panel>
                                        <!-- Simple text (no spans) -->
                                        <TextBlock Text="{Binding LeftText}"
                                                   FontFamily="Consolas,Courier New,monospace"
                                                   FontSize="13"
                                                   IsVisible="{Binding !HasSpans}"
                                                   TextWrapping="NoWrap" />
                                        <!-- Span-based text (word diff) -->
                                        <ItemsControl ItemsSource="{Binding LeftSpanViewModels}"
                                                      IsVisible="{Binding HasSpans}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <StackPanel Orientation="Horizontal" />
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="vm:SpanViewModel">
                                                    <Border Background="{Binding Background}">
                                                        <TextBlock Text="{Binding Text}"
                                                                   FontFamily="Consolas,Courier New,monospace"
                                                                   FontSize="13"
                                                                   TextWrapping="NoWrap" />
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </Panel>
                                </Border>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <!-- Vertical splitter -->
            <GridSplitter Grid.Column="1"
                          Background="#DDDDDD"
                          ResizeDirection="Columns" />

            <!-- Right panel -->
            <ScrollViewer x:Name="RightScrollViewer"
                          Grid.Column="2"
                          HorizontalScrollBarVisibility="Auto"
                          VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding Lines}"
                              Background="White">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:DiffLineViewModel">
                            <Grid ColumnDefinitions="48,*"
                                  Background="{Binding Background}"
                                  MinHeight="20">
                                <!-- Line number -->
                                <Border Grid.Column="0"
                                        Background="#F0F0F0"
                                        BorderBrush="#DDDDDD"
                                        BorderThickness="0,0,1,0"
                                        Padding="4,1">
                                    <TextBlock Text="{Binding RightLineNumberText}"
                                               FontFamily="Consolas,Courier New,monospace"
                                               FontSize="12"
                                               Foreground="#888888"
                                               TextAlignment="Right" />
                                </Border>
                                <!-- Content -->
                                <Border Grid.Column="1" Padding="4,1">
                                    <Panel>
                                        <!-- Simple text (no spans) -->
                                        <TextBlock Text="{Binding RightText}"
                                                   FontFamily="Consolas,Courier New,monospace"
                                                   FontSize="13"
                                                   IsVisible="{Binding !HasSpans}"
                                                   TextWrapping="NoWrap" />
                                        <!-- Span-based text (word diff) -->
                                        <ItemsControl ItemsSource="{Binding RightSpanViewModels}"
                                                      IsVisible="{Binding HasSpans}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <StackPanel Orientation="Horizontal" />
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="vm:SpanViewModel">
                                                    <Border Background="{Binding Background}">
                                                        <TextBlock Text="{Binding Text}"
                                                                   FontFamily="Consolas,Courier New,monospace"
                                                                   FontSize="13"
                                                                   TextWrapping="NoWrap" />
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </Panel>
                                </Border>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Grid>
    </Grid>
</UserControl>
