<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Codiff.ViewModels"
        xmlns:views="using:Codiff.Views"
        x:Class="Codiff.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="Codiff"
        Width="1280"
        Height="800"
        MinWidth="800"
        MinHeight="500">

    <DockPanel>
        <!-- Top Toolbar -->
        <Border DockPanel.Dock="Top"
                Background="#F0F0F0"
                BorderBrush="#CCCCCC"
                BorderThickness="0,0,0,1"
                Padding="8,6">
            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button Content="Open Files"
                        Command="{Binding OpenFilesCommand}"
                        Padding="12,6" />
                <Button Content="Open Folders"
                        Command="{Binding OpenFoldersCommand}"
                        Padding="12,6" />
            </StackPanel>
        </Border>

        <!-- Main content area -->
        <Grid>
            <views:FileDiffView DataContext="{Binding FileDiffViewModel}" />
        </Grid>
    </DockPanel>
</Window>
