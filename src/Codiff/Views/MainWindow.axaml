<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Codiff.ViewModels"
        xmlns:views="using:Codiff.Views"
        x:Class="Codiff.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="Codiff"
        Width="1280"
        Height="960"
        MinWidth="800"
        MinHeight="500"
        DragDrop.AllowDrop="True">

    <DockPanel>
        <!-- Menu bar -->
        <Menu DockPanel.Dock="Top" x:Name="MainMenu">
            <MenuItem Header="Directories">
                <MenuItem Header="New Comparison"
                          Command="{Binding OpenFoldersCommand}">
                    <MenuItem.Icon>
                        <PathIcon Data="{StaticResource IconNewComparison}" Width="16" Height="16" />
                    </MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="Re-compare"
                          Command="{Binding FolderDiffViewModel.RecompareCommand}">
                    <MenuItem.Icon>
                        <PathIcon Data="{StaticResource IconRecompare}" Width="16" Height="16" />
                    </MenuItem.Icon>
                </MenuItem>
                <Separator />
                <MenuItem x:Name="RecentMenuItem"
                          Header="Recent Files/Directories"
                          IsEnabled="{Binding HasRecentComparisons}">
                    <MenuItem.Icon>
                        <PathIcon Data="{StaticResource IconRecentComparisons}" Width="16" Height="16" />
                    </MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="Clear Recent"
                          Command="{Binding ClearRecentCommand}"
                          IsEnabled="{Binding HasRecentComparisons}">
                    <MenuItem.Icon>
                        <PathIcon Data="{StaticResource IconClearRecent}" Width="16" Height="16" />
                    </MenuItem.Icon>
                </MenuItem>
                <Separator />
                <MenuItem Header="Swap Directories"
                          Command="{Binding FolderDiffViewModel.SwapDirectoriesCommand}">
                    <MenuItem.Icon>
                        <PathIcon Data="{StaticResource IconSwapDirectories}" Width="16" Height="16" />
                    </MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="Up One Level for Both"
                          Command="{Binding FolderDiffViewModel.UpOneLevelCommand}">
                    <MenuItem.Icon>
                        <PathIcon Data="{StaticResource IconUpOneLevel}" Width="16" Height="16" />
                    </MenuItem.Icon>
                </MenuItem>
                <Separator />
                <MenuItem Header="Exit"
                          Command="{Binding ExitCommand}">
                    <MenuItem.Icon>
                        <PathIcon Data="{StaticResource IconExit}" Width="16" Height="16" />
                    </MenuItem.Icon>
                </MenuItem>
            </MenuItem>
            <MenuItem Header="Files">
                <MenuItem Header="Compare Files..."
                          Command="{Binding OpenFilesCommand}">
                    <MenuItem.Icon>
                        <PathIcon Data="{StaticResource IconOpenFiles}" Width="16" Height="16" />
                    </MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="Recompare"
                          Command="{Binding FileDiffViewModel.RecompareCommand}"
                          IsEnabled="{Binding !IsFolderViewVisible}"
                          InputGesture="{x:Static views:Shortcuts.Recompare}">
                    <MenuItem.Icon>
                        <PathIcon Data="{StaticResource IconRecompare}" Width="16" Height="16" />
                    </MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="Swap Files"
                          Command="{Binding FileDiffViewModel.SwapCommand}"
                          IsEnabled="{Binding !IsFolderViewVisible}">
                    <MenuItem.Icon>
                        <PathIcon Data="{StaticResource IconSwapDirectories}" Width="16" Height="16" />
                    </MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="Save"
                          Command="{Binding FileDiffViewModel.SaveCommand}"
                          IsEnabled="{Binding !IsFolderViewVisible}"
                          InputGesture="{x:Static views:Shortcuts.Save}">
                    <MenuItem.Icon>
                        <PathIcon Data="{StaticResource IconSave}" Width="16" Height="16" />
                    </MenuItem.Icon>
                </MenuItem>
                <Separator />
                <MenuItem Header="First Difference"
                          Command="{Binding FileDiffViewModel.FirstDiffCommand}"
                          IsEnabled="{Binding !IsFolderViewVisible}"
                          InputGesture="{x:Static views:Shortcuts.FirstDifference}">
                    <MenuItem.Icon>
                        <PathIcon Data="{StaticResource IconFirstDiff}" Width="16" Height="16" />
                    </MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="Previous Difference"
                          Command="{Binding FileDiffViewModel.PrevDiffCommand}"
                          IsEnabled="{Binding !IsFolderViewVisible}"
                          InputGesture="{x:Static views:Shortcuts.PreviousDifference}">
                    <MenuItem.Icon>
                        <PathIcon Data="{StaticResource IconPreviousDiff}" Width="16" Height="16" />
                    </MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="Next Difference"
                          Command="{Binding FileDiffViewModel.NextDiffCommand}"
                          IsEnabled="{Binding !IsFolderViewVisible}"
                          InputGesture="{x:Static views:Shortcuts.NextDifference}">
                    <MenuItem.Icon>
                        <PathIcon Data="{StaticResource IconNextDiff}" Width="16" Height="16" />
                    </MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="Last Difference"
                          Command="{Binding FileDiffViewModel.LastDiffCommand}"
                          IsEnabled="{Binding !IsFolderViewVisible}"
                          InputGesture="{x:Static views:Shortcuts.LastDifference}">
                    <MenuItem.Icon>
                        <PathIcon Data="{StaticResource IconLastDiff}" Width="16" Height="16" />
                    </MenuItem.Icon>
                </MenuItem>
                <Separator />
                <MenuItem Header="Copy Difference to Right"
                          Command="{Binding FileDiffViewModel.CopyToRightCommand}"
                          IsEnabled="{Binding !IsFolderViewVisible}"
                          InputGesture="{x:Static views:Shortcuts.CopyToRight}">
                    <MenuItem.Icon>
                        <PathIcon Data="{StaticResource IconCopyToRight}" Width="16" Height="16" />
                    </MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="Copy Difference to Left"
                          Command="{Binding FileDiffViewModel.CopyToLeftCommand}"
                          IsEnabled="{Binding !IsFolderViewVisible}"
                          InputGesture="{x:Static views:Shortcuts.CopyToLeft}">
                    <MenuItem.Icon>
                        <PathIcon Data="{StaticResource IconCopyToLeft}" Width="16" Height="16" />
                    </MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="Undo Copy"
                          Command="{Binding FileDiffViewModel.UndoCommand}"
                          IsEnabled="{Binding !IsFolderViewVisible}"
                          InputGesture="{x:Static views:Shortcuts.Undo}">
                    <MenuItem.Icon>
                        <PathIcon Data="{StaticResource IconUndo}" Width="16" Height="16" />
                    </MenuItem.Icon>
                </MenuItem>
                <Separator />
                <MenuItem Header="Find..."
                          Click="OnFindMenuItemClick"
                          IsEnabled="{Binding !IsFolderViewVisible}"
                          InputGesture="{x:Static views:Shortcuts.Find}">
                    <MenuItem.Icon>
                        <PathIcon Data="{StaticResource IconFind}" Width="16" Height="16" />
                    </MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="Go to Line..."
                          Click="OnGoToLineMenuItemClick"
                          IsEnabled="{Binding !IsFolderViewVisible}"
                          InputGesture="{x:Static views:Shortcuts.GoToLine}">
                    <MenuItem.Icon>
                        <PathIcon Data="{StaticResource IconGoToLine}" Width="16" Height="16" />
                    </MenuItem.Icon>
                </MenuItem>
                <Separator />
                <MenuItem Header="Copy Differences as Unified Diff"
                          Click="OnCopyUnifiedDiffMenuItemClick"
                          IsEnabled="{Binding !IsFolderViewVisible}">
                    <MenuItem.Icon>
                        <PathIcon Data="{StaticResource IconCopyToClipboard}" Width="16" Height="16" />
                    </MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="Save Differences as Unified Diff..."
                          Click="OnSaveUnifiedDiffMenuItemClick"
                          IsEnabled="{Binding !IsFolderViewVisible}">
                    <MenuItem.Icon>
                        <PathIcon Data="{StaticResource IconExportDiff}" Width="16" Height="16" />
                    </MenuItem.Icon>
                </MenuItem>
            </MenuItem>
            <MenuItem Header="Edit">
                <MenuItem Header="Copy as Text"
                          Command="{Binding FileDiffViewModel.CopyAsTextCommand}">
                    <MenuItem.Icon>
                        <PathIcon Data="{StaticResource IconCopyAsText}" Width="16" Height="16" />
                    </MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="Copy to Clipboard"
                          Command="{Binding FolderDiffViewModel.CopyToClipboardCommand}">
                    <MenuItem.Icon>
                        <PathIcon Data="{StaticResource IconCopyToClipboard}" Width="16" Height="16" />
                    </MenuItem.Icon>
                </MenuItem>
                <Separator />
                <MenuItem Header="Delete"
                          Command="{Binding FolderDiffViewModel.DeleteCommand}">
                    <MenuItem.Icon>
                        <PathIcon Data="{StaticResource IconDelete}" Width="16" Height="16" />
                    </MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="Delete from Both Sides"
                          Command="{Binding FolderDiffViewModel.DeleteFromBothCommand}">
                    <MenuItem.Icon>
                        <PathIcon Data="{StaticResource IconDeleteFromBoth}" Width="16" Height="16" />
                    </MenuItem.Icon>
                </MenuItem>
            </MenuItem>
            <MenuItem Header="View">
                <MenuItem Header="Show Only First Directory"
                          Command="{Binding FolderDiffViewModel.ShowOnlyFirstDirectoryCommand}">
                    <MenuItem.Icon>
                        <PathIcon Data="{StaticResource IconShowOnlyFirst}" Width="16" Height="16" />
                    </MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="Show Only Second Directory"
                          Command="{Binding FolderDiffViewModel.ShowOnlySecondDirectoryCommand}">
                    <MenuItem.Icon>
                        <PathIcon Data="{StaticResource IconShowOnlySecond}" Width="16" Height="16" />
                    </MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="Show Both Directories"
                          Command="{Binding FolderDiffViewModel.ShowBothDirectoriesCommand}">
                    <MenuItem.Icon>
                        <PathIcon Data="{StaticResource IconShowBoth}" Width="16" Height="16" />
                    </MenuItem.Icon>
                </MenuItem>
                <Separator />
                <MenuItem Header="Show Identical Files"
                          ToggleType="CheckBox"
                          IsChecked="{Binding FolderDiffViewModel.ShowIdenticalFiles, Mode=TwoWay}" />
                <MenuItem Header="Show Different Files"
                          ToggleType="CheckBox"
                          IsChecked="{Binding FolderDiffViewModel.ShowDifferentFiles, Mode=TwoWay}" />
                <MenuItem Header="Show Files Only in First Directory"
                          ToggleType="CheckBox"
                          IsChecked="{Binding FolderDiffViewModel.ShowLeftOnlyFiles, Mode=TwoWay}" />
                <MenuItem Header="Show Files Only in Second Directory"
                          ToggleType="CheckBox"
                          IsChecked="{Binding FolderDiffViewModel.ShowRightOnlyFiles, Mode=TwoWay}" />
                <Separator />
                <MenuItem Header="Expand All"
                          Command="{Binding FolderDiffViewModel.ExpandAllCommand}">
                    <MenuItem.Icon>
                        <PathIcon Data="{StaticResource IconExpandAll}" Width="16" Height="16" />
                    </MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="Collapse All"
                          Command="{Binding FolderDiffViewModel.CollapseAllCommand}">
                    <MenuItem.Icon>
                        <PathIcon Data="{StaticResource IconCollapseAll}" Width="16" Height="16" />
                    </MenuItem.Icon>
                </MenuItem>
                <Separator />
                <MenuItem Header="{Binding ThemeMenuHeader}"
                          Command="{Binding ToggleThemeCommand}">
                    <MenuItem.Icon>
                        <PathIcon Data="{StaticResource IconThemeToggle}" Width="16" Height="16" />
                    </MenuItem.Icon>
                </MenuItem>
                <Separator />
                <MenuItem Header="{Binding FileDiffViewModel.SplitterOrientationMenuHeader}"
                          Command="{Binding FileDiffViewModel.ToggleSplitterOrientationCommand}">
                    <MenuItem.Icon>
                        <PathIcon Data="{StaticResource IconToggleSplitterOrientation}" Width="16" Height="16" />
                    </MenuItem.Icon>
                </MenuItem>
            </MenuItem>
            <MenuItem Header="Options">
                <MenuItem Header="Ignore White Space"
                          ToggleType="CheckBox"
                          IsChecked="{Binding FileDiffViewModel.IgnoreWhiteSpace, Mode=TwoWay}">
                    <MenuItem.Icon>
                        <PathIcon Data="{StaticResource IconIgnoreWhiteSpace}" Width="16" Height="16" />
                    </MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="Ignore Case"
                          ToggleType="CheckBox"
                          IsChecked="{Binding FileDiffViewModel.IgnoreCase, Mode=TwoWay}">
                    <MenuItem.Icon>
                        <PathIcon Data="{StaticResource IconIgnoreCase}" Width="16" Height="16" />
                    </MenuItem.Icon>
                </MenuItem>
                <Separator />
                <MenuItem Header="Syntax Highlighting"
                          ToggleType="CheckBox"
                          IsChecked="{Binding FileDiffViewModel.SyntaxHighlighting, Mode=TwoWay}">
                    <MenuItem.Icon>
                        <PathIcon Data="{StaticResource IconSyntaxHighlighting}" Width="16" Height="16" />
                    </MenuItem.Icon>
                </MenuItem>
            </MenuItem>
        </Menu>

        <Border DockPanel.Dock="Top"
                Background="{DynamicResource ToolbarBackground}"
                BorderBrush="{DynamicResource ToolbarBorderBrush}"
                BorderThickness="0,0,0,1"
                Padding="8,6">
            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button Content="📑 Open Files"
                        Command="{Binding OpenFilesCommand}"
                        Padding="12,6" />
                <Button Content="📂 Open Folders"
                        Command="{Binding OpenFoldersCommand}"
                        Padding="12,6" />
            </StackPanel>
        </Border>

        <Grid>
            <Panel IsVisible="{Binding !IsFolderViewVisible}">
                <views:FileDiffView x:Name="FileView" DataContext="{Binding FileDiffViewModel}" />
            </Panel>
            <Panel IsVisible="{Binding IsFolderViewVisible}">
                <views:FolderDiffView DataContext="{Binding FolderDiffViewModel}" />
            </Panel>
        </Grid>
    </DockPanel>
</Window>
