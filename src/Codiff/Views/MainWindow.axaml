<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Codiff.ViewModels"
        xmlns:views="using:Codiff.Views"
        x:Class="Codiff.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="Codiff"
        Width="1280"
        Height="960"
        MinWidth="800"
        MinHeight="500">

    <DockPanel>
        <!-- Menu bar -->
        <Menu DockPanel.Dock="Top">
            <MenuItem Header="Directories">
                <MenuItem Header="New Comparison"
                          Command="{Binding OpenFoldersCommand}">
                    <MenuItem.Icon>
                        <PathIcon Data="{StaticResource IconNewComparison}" Width="16" Height="16" />
                    </MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="Re-compare"
                          Command="{Binding FolderDiffViewModel.RecompareCommand}">
                    <MenuItem.Icon>
                        <PathIcon Data="{StaticResource IconRecompare}" Width="16" Height="16" />
                    </MenuItem.Icon>
                </MenuItem>
                <Separator />
                <MenuItem Header="Recent Files/Directories"
                          IsEnabled="{Binding HasRecentComparisons}"
                          ItemsSource="{Binding RecentComparisons}">
                    <MenuItem.Icon>
                        <PathIcon Data="{StaticResource IconRecentComparisons}" Width="16" Height="16" />
                    </MenuItem.Icon>
                    <MenuItem.ItemContainerTheme>
                        <ControlTheme TargetType="MenuItem" x:DataType="vm:RecentComparisonViewModel">
                            <Setter Property="Header" Value="{Binding DisplayText}" />
                            <Setter Property="Command" Value="{Binding OpenCommand}" />
                        </ControlTheme>
                    </MenuItem.ItemContainerTheme>
                </MenuItem>
                <MenuItem Header="Clear Recent"
                          Command="{Binding ClearRecentCommand}"
                          IsEnabled="{Binding HasRecentComparisons}">
                    <MenuItem.Icon>
                        <PathIcon Data="{StaticResource IconClearRecent}" Width="16" Height="16" />
                    </MenuItem.Icon>
                </MenuItem>
                <Separator />
                <MenuItem Header="Swap Directories"
                          Command="{Binding FolderDiffViewModel.SwapDirectoriesCommand}">
                    <MenuItem.Icon>
                        <PathIcon Data="{StaticResource IconSwapDirectories}" Width="16" Height="16" />
                    </MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="Up One Level for Both"
                          Command="{Binding FolderDiffViewModel.UpOneLevelCommand}">
                    <MenuItem.Icon>
                        <PathIcon Data="{StaticResource IconUpOneLevel}" Width="16" Height="16" />
                    </MenuItem.Icon>
                </MenuItem>
                <Separator />
                <MenuItem Header="Exit"
                          Command="{Binding ExitCommand}">
                    <MenuItem.Icon>
                        <PathIcon Data="{StaticResource IconExit}" Width="16" Height="16" />
                    </MenuItem.Icon>
                </MenuItem>
            </MenuItem>
            <MenuItem Header="Edit">
                <MenuItem Header="Copy to Clipboard"
                          Command="{Binding FolderDiffViewModel.CopyToClipboardCommand}">
                    <MenuItem.Icon>
                        <PathIcon Data="{StaticResource IconCopyToClipboard}" Width="16" Height="16" />
                    </MenuItem.Icon>
                </MenuItem>
                <Separator />
                <MenuItem Header="Delete"
                          Command="{Binding FolderDiffViewModel.DeleteCommand}">
                    <MenuItem.Icon>
                        <PathIcon Data="{StaticResource IconDelete}" Width="16" Height="16" />
                    </MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="Delete from Both Sides"
                          Command="{Binding FolderDiffViewModel.DeleteFromBothCommand}">
                    <MenuItem.Icon>
                        <PathIcon Data="{StaticResource IconDeleteFromBoth}" Width="16" Height="16" />
                    </MenuItem.Icon>
                </MenuItem>
            </MenuItem>
            <MenuItem Header="View">
                <MenuItem Header="Show Only First Directory"
                          Command="{Binding FolderDiffViewModel.ShowOnlyFirstDirectoryCommand}">
                    <MenuItem.Icon>
                        <PathIcon Data="{StaticResource IconShowOnlyFirst}" Width="16" Height="16" />
                    </MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="Show Only Second Directory"
                          Command="{Binding FolderDiffViewModel.ShowOnlySecondDirectoryCommand}">
                    <MenuItem.Icon>
                        <PathIcon Data="{StaticResource IconShowOnlySecond}" Width="16" Height="16" />
                    </MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="Show Both Directories"
                          Command="{Binding FolderDiffViewModel.ShowBothDirectoriesCommand}">
                    <MenuItem.Icon>
                        <PathIcon Data="{StaticResource IconShowBoth}" Width="16" Height="16" />
                    </MenuItem.Icon>
                </MenuItem>
                <Separator />
                <MenuItem Header="Expand All"
                          Command="{Binding FolderDiffViewModel.ExpandAllCommand}">
                    <MenuItem.Icon>
                        <PathIcon Data="{StaticResource IconExpandAll}" Width="16" Height="16" />
                    </MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="Collapse All"
                          Command="{Binding FolderDiffViewModel.CollapseAllCommand}">
                    <MenuItem.Icon>
                        <PathIcon Data="{StaticResource IconCollapseAll}" Width="16" Height="16" />
                    </MenuItem.Icon>
                </MenuItem>
                <Separator />
                <MenuItem Header="{Binding ThemeMenuHeader}"
                          Command="{Binding ToggleThemeCommand}">
                    <MenuItem.Icon>
                        <PathIcon Data="{StaticResource IconThemeToggle}" Width="16" Height="16" />
                    </MenuItem.Icon>
                </MenuItem>
            </MenuItem>
        </Menu>

        <Border DockPanel.Dock="Top"
                Background="{DynamicResource ToolbarBackground}"
                BorderBrush="{DynamicResource ToolbarBorderBrush}"
                BorderThickness="0,0,0,1"
                Padding="8,6">
            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button Content="📑 Open Files"
                        Command="{Binding OpenFilesCommand}"
                        Padding="12,6" />
                <Button Content="📂 Open Folders"
                        Command="{Binding OpenFoldersCommand}"
                        Padding="12,6" />
            </StackPanel>
        </Border>

        <Grid>
            <Panel IsVisible="{Binding !IsFolderViewVisible}">
                <views:FileDiffView DataContext="{Binding FileDiffViewModel}" />
            </Panel>
            <Panel IsVisible="{Binding IsFolderViewVisible}">
                <views:FolderDiffView DataContext="{Binding FolderDiffViewModel}" />
            </Panel>
        </Grid>
    </DockPanel>
</Window>
