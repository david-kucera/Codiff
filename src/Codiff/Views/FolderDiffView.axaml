<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Codiff.ViewModels"
             x:Class="Codiff.Views.FolderDiffView"
             x:DataType="vm:FolderDiffViewModel">

    <UserControl.Styles>
        <!-- Make sortable column headers show a pointer cursor -->
        <Style Selector="DataGridColumnHeader">
            <Setter Property="Cursor" Value="Hand" />
        </Style>
    </UserControl.Styles>

    <Grid>
    <DockPanel>
        <!-- Path labels -->
        <Grid DockPanel.Dock="Top"
              x:Name="PathLabelsGrid"
              ColumnDefinitions="*,4,*"
              Margin="4,4,4,4">
            <!-- Left path label -->
            <Border Grid.Column="0"
                    Background="{DynamicResource FolderPathBackground}"
                    BorderBrush="{DynamicResource FolderPathBorderBrush}"
                    BorderThickness="1"
                    Padding="6,4">
                <TextBlock Text="{Binding LeftFolderPath}"
                           FontSize="13"
                           Foreground="{DynamicResource FolderPathForeground}"
                           TextTrimming="CharacterEllipsis"
                           ToolTip.Tip="{Binding LeftFolderPath}"
                           Cursor="Hand"
                           Tapped="OnLeftPathDoubleTapped" />
            </Border>

            <!-- Right path label -->
            <Border Grid.Column="2"
                    Background="{DynamicResource FolderPathBackground}"
                    BorderBrush="{DynamicResource FolderPathBorderBrush}"
                    BorderThickness="1"
                    Padding="6,4">
                <TextBlock Text="{Binding RightFolderPath}"
                           FontSize="13"
                           Foreground="{DynamicResource FolderPathForeground}"
                           TextTrimming="CharacterEllipsis"
                           ToolTip.Tip="{Binding RightFolderPath}"
                           Cursor="Hand"
                           Tapped="OnRightPathDoubleTapped" />
            </Border>
        </Grid>

        <!-- Legend -->
        <Border DockPanel.Dock="Bottom"
                Background="{DynamicResource LegendBackground}"
                BorderBrush="{DynamicResource LegendBorderBrush}"
                BorderThickness="0,1,0,0"
                Padding="8,4">
            <Grid>
                <StackPanel Orientation="Horizontal" Spacing="16">
                    <StackPanel Orientation="Horizontal" Spacing="4">
                        <Border Width="14" Height="14" Background="{DynamicResource DiffModifiedColor}" BorderBrush="{DynamicResource LegendBorderBrush}" BorderThickness="1" VerticalAlignment="Center" />
                        <TextBlock Text="Modified" FontSize="11" VerticalAlignment="Center" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="4">
                        <Border Width="14" Height="14" Background="{DynamicResource DiffPresentColor}" BorderBrush="{DynamicResource LegendBorderBrush}" BorderThickness="1" VerticalAlignment="Center" />
                        <TextBlock Text="Only in this side" FontSize="11" VerticalAlignment="Center" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="4">
                        <Border Width="14" Height="14" Background="{DynamicResource DiffMissingColor}" BorderBrush="{DynamicResource LegendBorderBrush}" BorderThickness="1" VerticalAlignment="Center" />
                        <TextBlock Text="Missing from this side" FontSize="11" VerticalAlignment="Center" />
                    </StackPanel>
                </StackPanel>

                <!-- Show Statistics button – visible only when the stats panel is closed -->
                <Button Content="📊 Show Statistics"
                        Command="{Binding ShowStatsCommand}"
                        IsVisible="{Binding !IsStatsVisible}"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        Padding="8,2"
                        FontSize="11"
                        Background="Transparent"
                        BorderThickness="1"
                        BorderBrush="#AAAAAA" />
            </Grid>
        </Border>

        <!-- Split panes + statistics bar -->
        <Grid x:Name="MainContentGrid"
              RowDefinitions="*,5,100"
              Margin="4,0,4,4">

            <!-- Row 0: left and right DataGrids -->
            <Grid Grid.Row="0"
                  x:Name="DataGridsPanel"
                  ColumnDefinitions="*,4,*">

                <!-- Left DataGrid -->
            <DataGrid x:Name="LeftDataGrid"
                      Grid.Column="0"
                      ItemsSource="{Binding FlatRows}"
                      SelectedItem="{Binding SelectedNode}"
                      AutoGenerateColumns="False"
                      CanUserResizeColumns="True"
                      CanUserSortColumns="False"
                      CanUserReorderColumns="False"
                      IsReadOnly="True"
                      Background="{DynamicResource DataGridBackground}"
                      GridLinesVisibility="Horizontal"
                      HeadersVisibility="Column"
                      DoubleTapped="OnGridDoubleTapped">
                <DataGrid.Styles>
                    <Style Selector="DataGridRow" x:DataType="vm:FolderNodeViewModel">
                        <Setter Property="Background" Value="{Binding LeftStatusColor}" />
                    </Style>
                </DataGrid.Styles>
                <DataGrid.Columns>

                    <!-- Expand/collapse toggle -->
                    <DataGridTemplateColumn Header="" Width="26" CanUserResize="False" CanUserSort="False">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate x:DataType="vm:FolderNodeViewModel">
                                <Button Content="{Binding ExpandSymbol}"
                                        Command="{Binding ToggleExpandedCommand}"
                                        IsVisible="{Binding IsExpandable}"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        Padding="2,1"
                                        FontSize="9"
                                        Background="Transparent"
                                        BorderThickness="0" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- Name (icon + label, indented) -->
                    <DataGridTemplateColumn Header="Name" Width="200" MinWidth="60">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate x:DataType="vm:FolderNodeViewModel">
                                <StackPanel Orientation="Horizontal"
                                            VerticalAlignment="Center"
                                            Spacing="2">
                                    <Border Width="{Binding IndentWidth}" Height="1" />
                                    <Image Source="{Binding LeftIcon}"
                                           Width="16" Height="16"
                                           VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding LeftName}"
                                               FontFamily="Consolas,Courier New,monospace"
                                               FontSize="11"
                                               VerticalAlignment="Center"
                                               Foreground="{DynamicResource CellTextForeground}"
                                               TextTrimming="CharacterEllipsis"
                                               ToolTip.Tip="{Binding LeftFullPath}"
                                               Margin="2,0,0,0" />
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- Size -->
                    <DataGridTemplateColumn Header="Size" Width="90" MinWidth="40">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate x:DataType="vm:FolderNodeViewModel">
                                <TextBlock Text="{Binding LeftSize}"
                                           FontFamily="Consolas,Courier New,monospace"
                                           FontSize="11"
                                           VerticalAlignment="Center"
                                           Foreground="{DynamicResource CellTextForeground}"
                                           HorizontalAlignment="Right"
                                           Margin="0,0,4,0" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- Type -->
                    <DataGridTemplateColumn Header="Type" Width="130" MinWidth="40">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate x:DataType="vm:FolderNodeViewModel">
                                <TextBlock Text="{Binding LeftType}"
                                           FontFamily="Consolas,Courier New,monospace"
                                           FontSize="11"
                                           VerticalAlignment="Center"
                                           Foreground="{DynamicResource CellTextForeground}"
                                           TextTrimming="CharacterEllipsis"
                                           Margin="4,0,0,0" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- Time -->
                    <DataGridTemplateColumn Header="Time" Width="160" MinWidth="60">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate x:DataType="vm:FolderNodeViewModel">
                                <TextBlock Text="{Binding LeftTime}"
                                           FontFamily="Consolas,Courier New,monospace"
                                           FontSize="11"
                                           VerticalAlignment="Center"
                                           Foreground="{DynamicResource CellTextForeground}"
                                           Margin="4,0,0,0" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                </DataGrid.Columns>
            </DataGrid>

            <!-- Vertical splitter -->
                <GridSplitter Grid.Column="1"
                              Background="{DynamicResource SplitterBrush}"
                              ResizeDirection="Columns" />

            <!-- Right DataGrid -->
            <DataGrid x:Name="RightDataGrid"
                      Grid.Column="2"
                      ItemsSource="{Binding FlatRows}"
                      SelectedItem="{Binding SelectedNode}"
                      AutoGenerateColumns="False"
                      CanUserResizeColumns="True"
                      CanUserSortColumns="False"
                      CanUserReorderColumns="False"
                      IsReadOnly="True"
                      Background="{DynamicResource DataGridBackground}"
                      GridLinesVisibility="Horizontal"
                      HeadersVisibility="Column"
                      DoubleTapped="OnGridDoubleTapped">
                <DataGrid.Styles>
                    <Style Selector="DataGridRow" x:DataType="vm:FolderNodeViewModel">
                        <Setter Property="Background" Value="{Binding RightStatusColor}" />
                    </Style>
                </DataGrid.Styles>
                <DataGrid.Columns>

                    <!-- Expand/collapse toggle -->
                    <DataGridTemplateColumn Header="" Width="26" CanUserResize="False" CanUserSort="False">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate x:DataType="vm:FolderNodeViewModel">
                                <Button Content="{Binding ExpandSymbol}"
                                        Command="{Binding ToggleExpandedCommand}"
                                        IsVisible="{Binding IsExpandable}"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        Padding="2,1"
                                        FontSize="9"
                                        Background="Transparent"
                                        BorderThickness="0" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- Name (icon + label, indented) -->
                    <DataGridTemplateColumn Header="Name" Width="200" MinWidth="60">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate x:DataType="vm:FolderNodeViewModel">
                                <StackPanel Orientation="Horizontal"
                                            VerticalAlignment="Center"
                                            Spacing="2">
                                    <Border Width="{Binding IndentWidth}" Height="1" />
                                    <Image Source="{Binding RightIcon}"
                                           Width="16" Height="16"
                                           VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding RightName}"
                                               FontFamily="Consolas,Courier New,monospace"
                                               FontSize="11"
                                               VerticalAlignment="Center"
                                               Foreground="{DynamicResource CellTextForeground}"
                                               TextTrimming="CharacterEllipsis"
                                               ToolTip.Tip="{Binding RightFullPath}"
                                               Margin="2,0,0,0" />
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- Size -->
                    <DataGridTemplateColumn Header="Size" Width="90" MinWidth="40">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate x:DataType="vm:FolderNodeViewModel">
                                <TextBlock Text="{Binding RightSize}"
                                           FontFamily="Consolas,Courier New,monospace"
                                           FontSize="11"
                                           VerticalAlignment="Center"
                                           Foreground="{DynamicResource CellTextForeground}"
                                           HorizontalAlignment="Right"
                                           Margin="0,0,4,0" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- Type -->
                    <DataGridTemplateColumn Header="Type" Width="130" MinWidth="40">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate x:DataType="vm:FolderNodeViewModel">
                                <TextBlock Text="{Binding RightType}"
                                           FontFamily="Consolas,Courier New,monospace"
                                           FontSize="11"
                                           VerticalAlignment="Center"
                                           Foreground="{DynamicResource CellTextForeground}"
                                           TextTrimming="CharacterEllipsis"
                                           Margin="4,0,0,0" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- Time -->
                    <DataGridTemplateColumn Header="Time" Width="160" MinWidth="60">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate x:DataType="vm:FolderNodeViewModel">
                                <TextBlock Text="{Binding RightTime}"
                                           FontFamily="Consolas,Courier New,monospace"
                                           FontSize="11"
                                           VerticalAlignment="Center"
                                           Foreground="{DynamicResource CellTextForeground}"
                                           Margin="4,0,0,0" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                </DataGrid.Columns>
            </DataGrid>

            </Grid>

            <!-- Row 1: horizontal splitter for resizing the statistics panel -->
            <GridSplitter x:Name="StatsSplitter"
                          Grid.Row="1"
                          IsVisible="{Binding IsStatsVisible}"
                          ResizeDirection="Rows"
                          HorizontalAlignment="Stretch"
                          Background="{DynamicResource SplitterBrush}" />

            <!-- Row 2: statistics stacked bar chart -->
            <Border x:Name="StatsPanel"
                    Grid.Row="2"
                    IsVisible="{Binding IsStatsVisible}"
                    Background="{DynamicResource LegendBackground}"
                    BorderBrush="{DynamicResource LegendBorderBrush}"
                    BorderThickness="0,1,0,0">
                <Grid Margin="8,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- Stacked bar + legend labels -->
                    <StackPanel Grid.Column="0" Spacing="6">

                        <!-- 100% horizontal stacked bar -->
                        <Grid Height="26">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="{Binding IdenticalBarStar}" />
                                <ColumnDefinition Width="{Binding OneSideBarStar}" />
                                <ColumnDefinition Width="{Binding ModifiedBarStar}" />
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0"
                                    Background="#2C2C2C"
                                    CornerRadius="3,0,0,3"
                                    ToolTip.Tip="{Binding IdenticalLabel}" />
                            <Border Grid.Column="1"
                                    Background="#28A745"
                                    ToolTip.Tip="{Binding OneSideLabel}" />
                            <Border Grid.Column="2"
                                    Background="#FFC107"
                                    CornerRadius="0,3,3,0"
                                    ToolTip.Tip="{Binding ModifiedLabel}" />
                        </Grid>

                        <!-- Legend labels -->
                        <StackPanel Orientation="Horizontal" Spacing="16">
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <Border Width="12" Height="12" Background="#2C2C2C"
                                        CornerRadius="2" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding IdenticalLabel}" FontSize="11" VerticalAlignment="Center" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <Border Width="12" Height="12" Background="#28A745"
                                        CornerRadius="2" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding OneSideLabel}" FontSize="11" VerticalAlignment="Center" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <Border Width="12" Height="12" Background="#FFC107"
                                        CornerRadius="2" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding ModifiedLabel}" FontSize="11" VerticalAlignment="Center" />
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>

                    <!-- Close button -->
                    <Button Grid.Column="1"
                            Content="✕"
                            Command="{Binding CloseStatsCommand}"
                            VerticalAlignment="Top"
                            HorizontalAlignment="Right"
                            Padding="6,2"
                            FontSize="12"
                            Background="Transparent"
                            BorderThickness="0" />
                </Grid>
            </Border>

        </Grid>
    </DockPanel>

    <!-- Loading overlay shown while a folder comparison is running -->
    <Border IsVisible="{Binding IsLoading}"
            Background="#66000000">
        <Border Background="{DynamicResource DataGridBackground}"
                BorderBrush="{DynamicResource LegendBorderBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="24,20"
                HorizontalAlignment="Center"
                VerticalAlignment="Center">
            <StackPanel Spacing="12" Width="300">
                <TextBlock Text="Comparing folders"
                           FontSize="14"
                           FontWeight="SemiBold"
                           HorizontalAlignment="Center" />
                <ProgressBar Minimum="0"
                             Maximum="100"
                             Height="8"
                             Value="{Binding LoadingProgress}"
                             IsIndeterminate="{Binding IsProgressIndeterminate}" />
                <TextBlock Text="{Binding LoadingText}"
                           FontSize="12"
                           HorizontalAlignment="Center"
                           Foreground="{DynamicResource CellTextForeground}" />
            </StackPanel>
        </Border>
    </Border>
    </Grid>
</UserControl>
