<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Codiff.ViewModels"
             x:Class="Codiff.Views.FolderDiffView"
             x:DataType="vm:FolderDiffViewModel">

    <DockPanel>
        <!-- Path labels & split tree: left and right sides -->
		<Grid DockPanel.Dock="Top" RowDefinitions="Auto,*" ColumnDefinitions="*,4,*" Margin="4,4,4,0">
			<!-- Left path label -->
			<TextBlock Grid.Row="0" Grid.Column="0"
					   Text="{Binding LeftFolderPath}"
					   FontSize="16"
					   Foreground="Blue"
					   TextTrimming="CharacterEllipsis"
					   ToolTip.Tip="{Binding LeftFolderPath}"
					   Cursor="Hand"
					   Tapped="OnLeftPathDoubleTapped" />

			<!-- Right path label -->
			<TextBlock Grid.Row="0" Grid.Column="2"
					   Text="{Binding RightFolderPath}"
					   FontSize="16"
					   Foreground="Blue"
					   TextTrimming="CharacterEllipsis"
					   ToolTip.Tip="{Binding RightFolderPath}"
					   Cursor="Hand"
					   Tapped="OnRightPathDoubleTapped" />

			<!-- Split tree: left and right sides -->
          <Grid Grid.Row="1" Grid.ColumnSpan="3" ColumnDefinitions="*,4,*" Margin="0,4,0,0">
				<!-- Left side -->
               <ScrollViewer x:Name="LeftScrollViewer"
                             Grid.Column="0"
                             HorizontalScrollBarVisibility="Auto"
                             VerticalScrollBarVisibility="Auto">
                   <TreeView x:Name="LeftTree"
                             ItemsSource="{Binding RootNodes}"
                             Background="White">
					<TreeView.ItemTemplate>
						<DataTemplate x:DataType="vm:FolderNodeViewModel">
							<TreeViewItem ItemsSource="{Binding Children}" IsExpanded="{Binding IsExpanded, Mode=TwoWay}">
								<TreeViewItem.Header>
									<Border Background="{Binding LeftStatusColor}"
											Padding="2,1"
											DoubleTapped="OnNodeDoubleTapped">
										<Grid ColumnDefinitions="20,*">
											<!-- Status icon -->
											<TextBlock Grid.Column="0"
													   Text="{Binding LeftStatusIcon}"
													   FontFamily="Consolas,Courier New,monospace"
													   FontSize="12"
													   VerticalAlignment="Center"
													   HorizontalAlignment="Center" />

											<!-- Left name/path -->
											<TextBlock Grid.Column="1"
													   Text="{Binding LeftName}"
													   FontFamily="Consolas,Courier New,monospace"
													   FontSize="11"
													   VerticalAlignment="Center"
                                Foreground="Black"
													   TextTrimming="CharacterEllipsis"
													   ToolTip.Tip="{Binding LeftFullPath}" />
										</Grid>
									</Border>
								</TreeViewItem.Header>
							</TreeViewItem>
						</DataTemplate>
					</TreeView.ItemTemplate>
				</TreeView>
               </ScrollViewer>

				<!-- Vertical splitter -->
				<GridSplitter Grid.Column="1"
							  Background="#DDDDDD"
							  ResizeDirection="Columns" />

				<!-- Right side -->
               <ScrollViewer x:Name="RightScrollViewer"
                             Grid.Column="2"
                             HorizontalScrollBarVisibility="Auto"
                             VerticalScrollBarVisibility="Auto">
                   <TreeView x:Name="RightTree"
                             ItemsSource="{Binding RootNodes}"
                             Background="White">
					<TreeView.ItemTemplate>
						<DataTemplate x:DataType="vm:FolderNodeViewModel">
							<TreeViewItem ItemsSource="{Binding Children}" IsExpanded="{Binding IsExpanded, Mode=TwoWay}">
								<TreeViewItem.Header>
									<Border Background="{Binding RightStatusColor}"
											Padding="2,1"
											DoubleTapped="OnNodeDoubleTapped">
										<Grid ColumnDefinitions="20,*">
											<!-- Status icon -->
											<TextBlock Grid.Column="0"
													   Text="{Binding RightStatusIcon}"
													   FontFamily="Consolas,Courier New,monospace"
													   FontSize="12"
													   VerticalAlignment="Center"
													   HorizontalAlignment="Center" />

											<!-- Right name/path -->
											<TextBlock Grid.Column="1"
													   Text="{Binding RightName}"
													   FontFamily="Consolas,Courier New,monospace"
													   FontSize="11"
													   VerticalAlignment="Center"
                                Foreground="Black"
													   TextTrimming="CharacterEllipsis"
													   ToolTip.Tip="{Binding RightFullPath}" />
										</Grid>
									</Border>
								</TreeViewItem.Header>
							</TreeViewItem>
						</DataTemplate>
					</TreeView.ItemTemplate>
				</TreeView>
               </ScrollViewer>
			</Grid>
		</Grid>

        <!-- Legend -->
        <StackPanel DockPanel.Dock="Bottom"
                    Orientation="Horizontal"
                    Spacing="8"
                    Margin="8,4"
                    HorizontalAlignment="Center">
            <StackPanel Orientation="Horizontal" Spacing="2">
                <TextBlock Text="~" FontFamily="Consolas,Courier New,monospace" FontSize="11" />
                <TextBlock Text="modified" FontSize="10" Foreground="#666" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="2">
                <TextBlock Text="+" FontFamily="Consolas,Courier New,monospace" FontSize="11" />
                <TextBlock Text="only right" FontSize="10" Foreground="#666" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="2">
                <TextBlock Text="-" FontFamily="Consolas,Courier New,monospace" FontSize="11" />
                <TextBlock Text="only left" FontSize="10" Foreground="#666" />
            </StackPanel>
        </StackPanel>
    </DockPanel>
</UserControl>
