<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Codiff.ViewModels"
             x:Class="Codiff.Views.FolderDiffView"
             x:DataType="vm:FolderDiffViewModel">

    <DockPanel>
        <!-- Path labels & split tree: left and right sides -->
		<Grid DockPanel.Dock="Top" RowDefinitions="Auto,*" ColumnDefinitions="*,4,*" Margin="4,4,4,0">
			<!-- Left path label -->
			<TextBlock Grid.Row="0" Grid.Column="0"
					   Text="{Binding LeftFolderPath}"
					   FontSize="16"
					   Foreground="Blue"
					   TextTrimming="CharacterEllipsis"
					   ToolTip.Tip="{Binding LeftFolderPath}"
					   Cursor="Hand"
					   Tapped="OnLeftPathDoubleTapped" />

			<!-- Right path label -->
			<TextBlock Grid.Row="0" Grid.Column="2"
					   Text="{Binding RightFolderPath}"
					   FontSize="16"
					   Foreground="Blue"
					   TextTrimming="CharacterEllipsis"
					   ToolTip.Tip="{Binding RightFolderPath}"
					   Cursor="Hand"
					   Tapped="OnRightPathDoubleTapped" />

			<!-- Split tree: left and right sides -->
          <Grid Grid.Row="1" Grid.ColumnSpan="3" ColumnDefinitions="*,4,*" Margin="0,4,0,0">
				<!-- Left side -->
               <ScrollViewer x:Name="LeftScrollViewer"
                             Grid.Column="0"
                             HorizontalScrollBarVisibility="Auto"
                             VerticalScrollBarVisibility="Auto">
                   <TreeView x:Name="LeftTree"
                             ItemsSource="{Binding RootNodes}"
                             Background="White">
					<TreeView.ItemTemplate>
						<DataTemplate x:DataType="vm:FolderNodeViewModel">
							<TreeViewItem ItemsSource="{Binding Children}" IsExpanded="{Binding IsExpanded, Mode=TwoWay}">
								<TreeViewItem.Header>
									<Border Background="{Binding LeftStatusColor}"
											Padding="2,1"
											DoubleTapped="OnNodeDoubleTapped">
										<Grid ColumnDefinitions="24,200,80,100,120">
											<!-- File system icon -->
											<Image Grid.Column="0"
												   Source="{Binding LeftIcon}"
												   Width="16"
												   Height="16"
												   VerticalAlignment="Center"
												   HorizontalAlignment="Center"
												   Margin="2,0" />

											<!-- Name column -->
											<TextBlock Grid.Column="1"
													   Text="{Binding LeftName}"
													   FontFamily="Consolas,Courier New,monospace"
													   FontSize="11"
													   VerticalAlignment="Center"
                                    Foreground="Black"
													   TextTrimming="CharacterEllipsis"
													   ToolTip.Tip="{Binding LeftFullPath}"
													   Margin="4,0,4,0" />

											<!-- Size column -->
											<TextBlock Grid.Column="2"
													   Text="{Binding LeftSize}"
													   FontFamily="Consolas,Courier New,monospace"
													   FontSize="11"
													   VerticalAlignment="Center"
													   Foreground="Black"
													   HorizontalAlignment="Right"
													   Margin="4,0,4,0" />

											<!-- Type column -->
											<TextBlock Grid.Column="3"
													   Text="{Binding LeftType}"
													   FontFamily="Consolas,Courier New,monospace"
													   FontSize="11"
													   VerticalAlignment="Center"
													   Foreground="Black"
													   TextTrimming="CharacterEllipsis"
													   Margin="4,0,4,0" />

											<!-- Time column -->
											<TextBlock Grid.Column="4"
													   Text="{Binding LeftTime}"
													   FontFamily="Consolas,Courier New,monospace"
													   FontSize="11"
													   VerticalAlignment="Center"
													   Foreground="Black"
													   Margin="4,0,4,0" />
										</Grid>
									</Border>
								</TreeViewItem.Header>
							</TreeViewItem>
						</DataTemplate>
					</TreeView.ItemTemplate>
				</TreeView>
               </ScrollViewer>

				<!-- Vertical splitter -->
				<GridSplitter Grid.Column="1"
							  Background="#DDDDDD"
							  ResizeDirection="Columns" />

				<!-- Right side -->
                <ScrollViewer x:Name="RightScrollViewer"
                              Grid.Column="2"
                              HorizontalScrollBarVisibility="Auto"
                              VerticalScrollBarVisibility="Auto">
                    <TreeView x:Name="RightTree"
                              ItemsSource="{Binding RootNodes}"
                              Background="White">
					<TreeView.ItemTemplate>
						<DataTemplate x:DataType="vm:FolderNodeViewModel">
							<TreeViewItem ItemsSource="{Binding Children}" IsExpanded="{Binding IsExpanded, Mode=TwoWay}">
								<TreeViewItem.Header>
									<Border Background="{Binding RightStatusColor}"
											Padding="2,1"
											DoubleTapped="OnNodeDoubleTapped">
										<Grid ColumnDefinitions="24,200,80,100,120">
											<!-- File system icon -->
											<Image Grid.Column="0"
												   Source="{Binding RightIcon}"
												   Width="16"
												   Height="16"
												   VerticalAlignment="Center"
												   HorizontalAlignment="Center"
												   Margin="2,0" />

											<!-- Name column -->
											<TextBlock Grid.Column="1"
													   Text="{Binding RightName}"
													   FontFamily="Consolas,Courier New,monospace"
													   FontSize="11"
													   VerticalAlignment="Center"
													   Foreground="Black"
													   TextTrimming="CharacterEllipsis"
													   ToolTip.Tip="{Binding RightFullPath}"
													   Margin="4,0,4,0" />

											<!-- Size column -->
											<TextBlock Grid.Column="2"
													   Text="{Binding RightSize}"
													   FontFamily="Consolas,Courier New,monospace"
													   FontSize="11"
													   VerticalAlignment="Center"
													   Foreground="Black"
													   HorizontalAlignment="Right"
													   Margin="4,0,4,0" />

											<!-- Type column -->
											<TextBlock Grid.Column="3"
													   Text="{Binding RightType}"
													   FontFamily="Consolas,Courier New,monospace"
													   FontSize="11"
													   VerticalAlignment="Center"
													   Foreground="Black"
													   TextTrimming="CharacterEllipsis"
													   Margin="4,0,4,0" />

											<!-- Time column -->
											<TextBlock Grid.Column="4"
													   Text="{Binding RightTime}"
													   FontFamily="Consolas,Courier New,monospace"
													   FontSize="11"
													   VerticalAlignment="Center"
													   Foreground="Black"
													   Margin="4,0,4,0" />
										</Grid>
									</Border>
								</TreeViewItem.Header>
							</TreeViewItem>
						</DataTemplate>
					</TreeView.ItemTemplate>
				</TreeView>
                </ScrollViewer>
			</Grid>
		</Grid>
    </DockPanel>
</UserControl>
